{
  "name": "bookmark-tags",
  "description": "Browser extension that stores tags in titles",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "bun test ./tests/",
    "test:watch": "bun test --watch",
    "postinstall": "wxt prepare",
    "release": "bun scripts/release.ts",
    "lint:eslint": "eslint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-window": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.88.0",
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "commit-and-tag-version": "^13.1.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.11.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "wxt": "^0.21.4"
  }
}
